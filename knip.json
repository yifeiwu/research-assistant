{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["tests/**/*.test.ts"],
  "project": [
    "app/**/*.{ts,tsx,css}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "tests/**/*.ts"
  ],
  "ignore": ["tests/stubs/**"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
