# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Exa API key — https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# Upstash Redis — https://console.upstash.com/redis (turn state, cross-instance stream resumption + request caching)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: override the default Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# (The summarizer/map-step model is hardcoded to qwen/qwen3.8-27b in lib/config.ts.)

# Optional: Redis cache TTLs in seconds
# CACHE_SEARCH_TTL_SECONDS=900
# CACHE_NOTES_TTL_SECONDS=86400

# Optional: per-IP rate limits for POST /api/chat (Redis fixed windows; 0 disables a window)
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_HOUR=60

# Optional: FIFO queue for research turns (0 concurrent turns disables it)
# MAX_CONCURRENT_RESEARCH_TURNS=2
# MAX_QUEUED_RESEARCH_TURNS=20
# MAX_RESEARCH_QUEUE_WAIT_MS=120000

# Optional: sustained Exa requests per second across all instances (0 disables)
# EXA_REQUESTS_PER_SECOND=8

# Optional: max estimated tokens of research evidence injected into the final answer
# SYNTHESIS_EVIDENCE_TOKEN_BUDGET=3000

# Optional: set to 1 to enable verbose server logs (queries, search results, summarization)
# DEBUG_AGENT=1
